# docker compose settings for Sessionboxer (copy to .env). All optional.

# Release to run; the Sandbox image of the same version is pulled on first use.
SESSIONBOXER_VERSION=0.1.0

# Interface and port the UI is published on. 127.0.0.1 keeps it on this machine (pair phones
# through Settings → Devices and remote access instead of exposing the port); 0.0.0.0 for a LAN.
SESSIONBOXER_BIND=127.0.0.1
SESSIONBOXER_PORT=4000

# Behind a reverse proxy (Caddy, Traefik, Coolify): the address browsers use, and trust its headers.
#SESSIONBOXER_PUBLIC_URL=https://sessionboxer.example.com
#SESSIONBOXER_TRUST_PROXY=1

# Fixed access token; generated into the data volume when empty (`docker compose exec control-plane sessionboxer token`).
#SESSIONBOXER_ACCESS_TOKEN=

# Use another Sandbox image (a local `npm run build:image`, a mirror).
#SESSIONBOXER_IMAGE=
