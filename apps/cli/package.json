    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sessionboxer/control-plane": "1.3.0",
    "@sessionboxer/protocol": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
