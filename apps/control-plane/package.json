{
  "name": "@sessionboxer/control-plane",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Host-side server: Session lifecycle over Docker, SQLite history, REST + WebSocket API for the web UI.",
  "bin": {
    "sessionboxer-control-plane": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.3.0",
    "@sessionboxer/protocol": "1.1.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dockerode": "^4.0.0",
    "hono": "^4.10.0",
    "tar-fs": "^3.1.3",
    "tar-stream": "^3.1.5",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.0.0",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
