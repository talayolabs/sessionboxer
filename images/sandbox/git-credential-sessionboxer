#!/bin/sh
# git credential helper for a repository bound to one GitHub login:
#   git config credential.https://github.com.helper "sessionboxer <login>"
# answers github.com requests with the token gh holds for that login (gh auth token --user), so
# the repository's config names the account and never a token.
account="$1"
op="$2"
[ "$op" = "get" ] || exit 0
[ -n "$account" ] || exit 0
host=""
protocol=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in
    host=*) host="${line#host=}" ;;
    protocol=*) protocol="${line#protocol=}" ;;
  esac
done
[ "$host" = "github.com" ] || exit 0
if ! token=$(gh auth token --hostname github.com --user "$account" 2>/dev/null) || [ -z "$token" ]; then
  echo "sessionboxer: this repository is bound to @$account but gh is not logged in as it (see gh auth status; enable that GitHub entry for the Session)" >&2
  exit 1
fi
printf 'protocol=%s\nhost=%s\nusername=%s\npassword=%s\n' "$protocol" "$host" "$account" "$token"
