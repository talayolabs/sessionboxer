{
  "name": "sessionboxer",
  "private": true,
  "version": "1.5.0",
  "description": "Local session manager for coding agents: one Docker sandbox with a desktop per session.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @sessionboxer/web",
    "build:protocol": "tsc -b packages/protocol",
    "lint": "eslint .",
    "size-budget": "node scripts/size-budget.mjs",
    "dup": "jscpd",
    "typecheck": "tsc -b && npm run typecheck -w @sessionboxer/web",
    "test:telemetry": "tsc -b && node --test scripts/telemetry.test.mjs",
    "test:audit": "python3 -m unittest discover -s scripts -p 'test_audit_tools.py'",
    "test:attachments": "tsc -b && node --test scripts/attachment-paths.test.mjs",
    "test:auth": "tsc -b && node --test scripts/auth-origin.test.mjs",
    "test:desktop-tools": "tsc -b && node --test scripts/desktop-tool-descriptions.test.mjs",
    "test:provider-auth": "tsc -b && node --test scripts/provider-auth.test.mjs scripts/kimi-provider.test.mjs",
    "test:schema": "tsc -b && node --test scripts/schema-and-settings.test.mjs",
    "test:daemon-errors": "tsc -b && node --test scripts/daemon-errors.test.mjs",
    "test:session-manager": "tsc -b && node --test scripts/session-manager.test.mjs",
    "test:automations": "tsc -b && node --test scripts/automations.test.mjs",
    "test:mcp-events": "tsc -b && node --test scripts/mcp-events.test.mjs",
    "test:guest-vms": "tsc -b && node --test scripts/guest-vms.test.mjs",
    "test:sandbox-image": "tsc -b && node --test scripts/sandbox-image.test.mjs",
    "test:cross-package": "tsc -b && node --test scripts/cross-package.test.mjs",
    "test:pr-sync": "tsc -b && node --test scripts/pr-sync.test.mjs",
    "test:routes": "node --test scripts/routes.test.mjs",
    "test:feed": "tsc -b && node --disable-warning=ExperimentalWarning --test scripts/feed.test.mjs",
    "test:automation-form": "tsc -b && node --disable-warning=ExperimentalWarning --test scripts/automation-form.test.mjs",
    "test:session-settings": "tsc -b && node --disable-warning=ExperimentalWarning --test scripts/session-settings.test.mjs",
    "audit:tools": "python3 scripts/audit_tools.py",
    "clean": "tsc -b --clean",
    "build:image": "node scripts/build-image.mjs",
    "start": "node apps/control-plane/dist/index.js",
    "spike:acp": "node scripts/spike-acp.mjs",
    "pack": "node scripts/pack.mjs --tarball",
    "build:control-plane-image": "npm run pack && docker build -f images/control-plane/Dockerfile -t sessionboxer/control-plane:dev build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jscpd": "^5.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "license": "MIT"
}
